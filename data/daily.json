{
  "date": "2026-10-05",
  "id": "856",
  "title": "Score of Parentheses",
  "difficulty": "Medium",
  "link": "https://leetcode.com/problems/score-of-parentheses/",
  "topics": [
    "String",
    "Stack",
    "Bracket Sequences"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "Given a balanced parentheses string s, return the score of the string."
    },
    {
      "t": "text",
      "v": "The score of a balanced parentheses string is based on the following rule:"
    },
    {
      "t": "text",
      "v": "• \"()\" has score 1."
    },
    {
      "t": "text",
      "v": "• AB has score A + B, where A and B are balanced parentheses strings."
    },
    {
      "t": "text",
      "v": "• (A) has score 2 * A, where A is a balanced parentheses string."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "code",
      "v": "Input: s = \"()\"\nOutput: 1"
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "code",
      "v": "Input: s = \"(())\"\nOutput: 2"
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "code",
      "v": "Input: s = \"()()\"\nOutput: 2"
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 2 <= s.length <= 50"
    },
    {
      "t": "text",
      "v": "• s consists of only '(' and ')'."
    },
    {
      "t": "text",
      "v": "• s is a balanced parentheses string."
    }
  ]
}
