{
  "date": "2026-10-22",
  "id": "3942",
  "title": "Minimum Operations to Sort a Permutation",
  "difficulty": "Medium",
  "link": "https://leetcode.com/problems/minimum-operations-to-sort-a-permutation/",
  "topics": [
    "Array"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "You are given an integer array nums of length n, where nums is a permutation of the integers from 0 to n - 1."
    },
    {
      "t": "text",
      "v": "You may perform only the following operations:"
    },
    {
      "t": "text",
      "v": "• Reverse the entire array."
    },
    {
      "t": "text",
      "v": "• Rotate Left by One: Move the first element to the end of the array, and rest elements to left by one position."
    },
    {
      "t": "text",
      "v": "Return an integer denoting the minimum number of operations required to sort the array in increasing order. If it is not possible to sort the array using only the given operations, return -1."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "text",
      "v": "Input: nums = [0,2,1]"
    },
    {
      "t": "text",
      "v": "Output: 2"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "• Rotate Left by one: [2, 1, 0]"
    },
    {
      "t": "text",
      "v": "• Reverse the array: [0, 1, 2]"
    },
    {
      "t": "text",
      "v": "The array becomes sorted in 2 operations, which is minimal"
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "text",
      "v": "Input: nums = [1,0,2]"
    },
    {
      "t": "text",
      "v": "Output: 2"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "• Reverse the array: [2, 0, 1]"
    },
    {
      "t": "text",
      "v": "• Rotate Left by one: [0, 1, 2]"
    },
    {
      "t": "text",
      "v": "The array becomes sorted in 2 operations, which is minimal."
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "text",
      "v": "Input: nums = [2,0,1,3]"
    },
    {
      "t": "text",
      "v": "Output: -1"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "It is impossible to reach [2, 0, 1, 3]. Thus, the answer is -1."
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 1 <= n == nums.length <= 10^5"
    },
    {
      "t": "text",
      "v": "• 0 <= nums[i] <= n - 1"
    },
    {
      "t": "text",
      "v": "• nums is a permutation of integers from 0 to n - 1."
    }
  ]
}
