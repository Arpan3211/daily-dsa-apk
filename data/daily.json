{
  "date": "2026-10-28",
  "id": "3882",
  "title": "Minimum XOR Path in a Grid",
  "difficulty": "Medium",
  "link": "https://leetcode.com/problems/minimum-xor-path-in-a-grid/",
  "topics": [
    "Array",
    "Dynamic Programming",
    "Bit Manipulation",
    "Matrix"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "You are given a 2D integer array grid of size m * n."
    },
    {
      "t": "text",
      "v": "You start at the top-left cell (0, 0) and want to reach the bottom-right cell (m - 1, n - 1)."
    },
    {
      "t": "text",
      "v": "At each step, you may move either right or down."
    },
    {
      "t": "text",
      "v": "The cost of a path is defined as the bitwise XOR of all the values in the cells along that path, including the start and end cells."
    },
    {
      "t": "text",
      "v": "Return the minimum possible XOR value among all valid paths from (0, 0) to (m - 1, n - 1)."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "text",
      "v": "Input: grid = [[1,2],[3,4]]"
    },
    {
      "t": "text",
      "v": "Output: 6"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "There are two valid paths:"
    },
    {
      "t": "text",
      "v": "• (0, 0) → (0, 1) → (1, 1) with XOR: 1 XOR 2 XOR 4 = 7"
    },
    {
      "t": "text",
      "v": "• (0, 0) → (1, 0) → (1, 1) with XOR: 1 XOR 3 XOR 4 = 6"
    },
    {
      "t": "text",
      "v": "The minimum XOR value among all valid paths is 6."
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "text",
      "v": "Input: grid = [[6,7],[5,8]]"
    },
    {
      "t": "text",
      "v": "Output: 9"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "There are two valid paths:"
    },
    {
      "t": "text",
      "v": "• (0, 0) → (0, 1) → (1, 1) with XOR: 6 XOR 7 XOR 8 = 9"
    },
    {
      "t": "text",
      "v": "• (0, 0) → (1, 0) → (1, 1) with XOR: 6 XOR 5 XOR 8 = 11"
    },
    {
      "t": "text",
      "v": "The minimum XOR value among all valid paths is 9."
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "text",
      "v": "Input: grid = [[2,7,5]]"
    },
    {
      "t": "text",
      "v": "Output: 0"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "There is only one valid path:"
    },
    {
      "t": "text",
      "v": "• (0, 0) → (0, 1) → (0, 2) with XOR: 2 XOR 7 XOR 5 = 0"
    },
    {
      "t": "text",
      "v": "The XOR value of this path is 0, which is the minimum possible."
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 1 <= m == grid.length <= 1000"
    },
    {
      "t": "text",
      "v": "• 1 <= n == grid[i].length <= 1000"
    },
    {
      "t": "text",
      "v": "• m * n <= 1000"
    },
    {
      "t": "text",
      "v": "• 0 <= grid[i][j] <= 1023​"
    }
  ]
}
