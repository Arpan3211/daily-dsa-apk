{
  "date": "2026-09-28",
  "id": "1614",
  "title": "Maximum Nesting Depth of the Parentheses",
  "difficulty": "Easy",
  "link": "https://leetcode.com/problems/maximum-nesting-depth-of-the-parentheses/",
  "topics": [
    "String",
    "Stack",
    "Bracket Sequences"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "Given a valid parentheses string s, return the nesting depth of s. The nesting depth is the maximum number of nested parentheses."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "text",
      "v": "Input: s = \"(1+(2*3)+((8)/4))+1\""
    },
    {
      "t": "text",
      "v": "Output: 3"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "Digit 8 is inside of 3 nested parentheses in the string."
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "text",
      "v": "Input: s = \"(1)+((2))+(((3)))\""
    },
    {
      "t": "text",
      "v": "Output: 3"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "Digit 3 is inside of 3 nested parentheses in the string."
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "text",
      "v": "Input: s = \"()(())((()()))\""
    },
    {
      "t": "text",
      "v": "Output: 3"
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 1 <= s.length <= 100"
    },
    {
      "t": "text",
      "v": "• s consists of digits 0-9 and characters '+', '-', '*', '/', '(', and ')'."
    },
    {
      "t": "text",
      "v": "• It is guaranteed that parentheses expression s is a VPS."
    }
  ]
}
