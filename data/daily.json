{
  "date": "2026-11-25",
  "id": "3934",
  "title": "Smallest Unique Subarray",
  "difficulty": "Hard",
  "link": "https://leetcode.com/problems/smallest-unique-subarray/",
  "topics": [
    "Array",
    "Hash Table",
    "Binary Search",
    "Rolling Hash",
    "Suffix Array",
    "Hash Function"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "You are given an integer array nums."
    },
    {
      "t": "text",
      "v": "Find the minimum length of a subarray that is not identical to any other subarray in nums."
    },
    {
      "t": "text",
      "v": "Return an integer denoting the minimum possible length of such a subarray."
    },
    {
      "t": "text",
      "v": "Two subarrays are considered identical if they have the same length and the same elements in corresponding positions."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "text",
      "v": "Input: nums = [3,3,3]"
    },
    {
      "t": "text",
      "v": "Output: 3"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "• Subarrays of length 1: [3] → appears 3 times"
    },
    {
      "t": "text",
      "v": "• Subarrays of length 2: [3, 3] → appears 2 times"
    },
    {
      "t": "text",
      "v": "• Subarrays of length 3: [3, 3, 3] → appears once"
    },
    {
      "t": "text",
      "v": "The subarray [3, 3, 3] is unique, so the smallest unique subarray length is 3."
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "text",
      "v": "Input: nums = [2,1,2,3,3]"
    },
    {
      "t": "text",
      "v": "Output: 1"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "Subarrays of length 1:"
    },
    {
      "t": "text",
      "v": "• [2] → appears 2 times"
    },
    {
      "t": "text",
      "v": "• [1] → appears once"
    },
    {
      "t": "text",
      "v": "• [3] → appears 2 times"
    },
    {
      "t": "text",
      "v": "The subarray [1] is unique, so the smallest unique subarray length is 1."
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "text",
      "v": "Input: nums = [1,1,2,2,1]"
    },
    {
      "t": "text",
      "v": "Output: 2"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "Subarrays of length 1:"
    },
    {
      "t": "text",
      "v": "• [1] → appears 3 times"
    },
    {
      "t": "text",
      "v": "• [2] → appears 2 times"
    },
    {
      "t": "text",
      "v": "Subarrays of length 2:"
    },
    {
      "t": "text",
      "v": "• [1, 1] → appears once"
    },
    {
      "t": "text",
      "v": "• [1, 2] → appears once"
    },
    {
      "t": "text",
      "v": "• [2, 2] → appears once"
    },
    {
      "t": "text",
      "v": "• [2, 1] → appears once"
    },
    {
      "t": "text",
      "v": "There is at least one subarray of length 2 that is unique, so the smallest unique subarray length is 2."
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 1 <= nums.length <= 10^5"
    },
    {
      "t": "text",
      "v": "• 1 <= nums[i] <= 10^5"
    }
  ]
}
