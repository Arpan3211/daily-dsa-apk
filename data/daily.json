{
  "date": "2026-11-12",
  "id": "3105",
  "title": "Longest Strictly Increasing or Strictly Decreasing Subarray",
  "difficulty": "Easy",
  "link": "https://leetcode.com/problems/longest-strictly-increasing-or-strictly-decreasing-subarray/",
  "topics": [
    "Array"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "You are given an array of integers nums. Return the length of the longest subarray of nums which is either strictly increasing or strictly decreasing."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "text",
      "v": "Input: nums = [1,4,3,3,2]"
    },
    {
      "t": "text",
      "v": "Output: 2"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "The strictly increasing subarrays of nums are [1], [2], [3], [3], [4], and [1,4]."
    },
    {
      "t": "text",
      "v": "The strictly decreasing subarrays of nums are [1], [2], [3], [3], [4], [3,2], and [4,3]."
    },
    {
      "t": "text",
      "v": "Hence, we return 2."
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "text",
      "v": "Input: nums = [3,3,3,3]"
    },
    {
      "t": "text",
      "v": "Output: 1"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "The strictly increasing subarrays of nums are [3], [3], [3], and [3]."
    },
    {
      "t": "text",
      "v": "The strictly decreasing subarrays of nums are [3], [3], [3], and [3]."
    },
    {
      "t": "text",
      "v": "Hence, we return 1."
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "text",
      "v": "Input: nums = [3,2,1]"
    },
    {
      "t": "text",
      "v": "Output: 3"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "The strictly increasing subarrays of nums are [3], [2], and [1]."
    },
    {
      "t": "text",
      "v": "The strictly decreasing subarrays of nums are [3], [2], [1], [3,2], [2,1], and [3,2,1]."
    },
    {
      "t": "text",
      "v": "Hence, we return 3."
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 1 <= nums.length <= 50"
    },
    {
      "t": "text",
      "v": "• 1 <= nums[i] <= 50"
    }
  ]
}
