  "date": "2026-10-04",
  "id": "678",
  "title": "Valid Parenthesis String",
  "difficulty": "Medium",
  "link": "https://leetcode.com/problems/valid-parenthesis-string/",
  "topics": [
    "String",
    "Dynamic Programming",
    "Stack",
    "Greedy",
    "Bracket Sequences"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "Given a string s containing only three types of characters: '(', ')' and '*', return true if s is valid."
    },
    {
      "t": "text",
      "v": "The following rules define a valid string:"
    },
    {
      "t": "text",
      "v": "• Any left parenthesis '(' must have a corresponding right parenthesis ')'."
    },
    {
      "t": "text",
      "v": "• Any right parenthesis ')' must have a corresponding left parenthesis '('."
    },
    {
      "t": "text",
      "v": "• Left parenthesis '(' must go before the corresponding right parenthesis ')'."
    },
    {
      "t": "text",
      "v": "• '*' could be treated as a single right parenthesis ')' or a single left parenthesis '(' or an empty string \"\"."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "code",
      "v": "Input: s = \"()\"\nOutput: true"
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "code",
      "v": "Input: s = \"(*)\"\nOutput: true"
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "code",
      "v": "Input: s = \"(*))\"\nOutput: true"
    },
    {
      "t": "text",
      "v": "Example 4:"
    },
    {
      "t": "code",
      "v": "Input: s = \"(\"\nOutput: false"
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 1 <= s.length <= 100"
    },
    {
      "t": "text",
      "v": "• s[i] is '(', ')' or '*'."
    }
  ]
}
