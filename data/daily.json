  "blocks": [
    {
      "t": "text",
      "v": "Given a string containing just the characters '(' and ')', return the length of the longest valid (well-formed) parentheses substring."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "code",
      "v": "Input: s = \"(()\"\nOutput: 2\nExplanation: The longest valid parentheses substring is \"()\"."
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "code",
      "v": "Input: s = \")()())\"\nOutput: 4\nExplanation: The longest valid parentheses substring is \"()()\"."
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "code",
      "v": "Input: s = \"\"\nOutput: 0"
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 0 <= s.length <= 3 * 10^4"
    },
    {
      "t": "text",
      "v": "• s[i] is '(', or ')'."
    }
  ]
}
