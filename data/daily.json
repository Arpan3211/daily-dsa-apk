{
  "date": "2026-11-03",
  "id": "3736",
  "title": "Minimum Moves to Equal Array Elements III",
  "difficulty": "Easy",
  "link": "https://leetcode.com/problems/minimum-moves-to-equal-array-elements-iii/",
  "topics": [
    "Array",
    "Math"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "You are given an integer array nums."
    },
    {
      "t": "text",
      "v": "In one move, you may increase the value of any single element nums[i] by 1."
    },
    {
      "t": "text",
      "v": "Return the minimum total number of moves required so that all elements in nums become equal."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "text",
      "v": "Input: nums = [2,1,3]"
    },
    {
      "t": "text",
      "v": "Output: 3"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "To make all elements equal:"
    },
    {
      "t": "text",
      "v": "• Increase nums[0] = 2 by 1 to make it 3."
    },
    {
      "t": "text",
      "v": "• Increase nums[1] = 1 by 1 to make it 2."
    },
    {
      "t": "text",
      "v": "• Increase nums[1] = 2 by 1 to make it 3."
    },
    {
      "t": "text",
      "v": "Now, all elements of nums are equal to 3. The minimum total moves is 3."
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "text",
      "v": "Input: nums = [4,4,5]"
    },
    {
      "t": "text",
      "v": "Output: 2"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "To make all elements equal:"
    },
    {
      "t": "text",
      "v": "• Increase nums[0] = 4 by 1 to make it 5."
    },
    {
      "t": "text",
      "v": "• Increase nums[1] = 4 by 1 to make it 5."
    },
    {
      "t": "text",
      "v": "Now, all elements of nums are equal to 5. The minimum total moves is 2."
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 1 <= nums.length <= 100"
    },
    {
      "t": "text",
      "v": "• 1 <= nums[i] <= 100"
    }
  ]
}
