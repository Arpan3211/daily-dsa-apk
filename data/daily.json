{
  "date": "2026-11-24",
  "id": "3411",
  "title": "Maximum Subarray With Equal Products",
  "difficulty": "Easy",
  "link": "https://leetcode.com/problems/maximum-subarray-with-equal-products/",
  "topics": [
    "Array",
    "Math",
    "Sliding Window",
    "Enumeration",
    "Number Theory"
  ],
  "blocks": [
    {
      "t": "text",
      "v": "You are given an array of positive integers nums."
    },
    {
      "t": "text",
      "v": "An array arr is called product equivalent if prod(arr) == lcm(arr) * gcd(arr), where:"
    },
    {
      "t": "text",
      "v": "• prod(arr) is the product of all elements of arr."
    },
    {
      "t": "text",
      "v": "• gcd(arr) is the GCD of all elements of arr."
    },
    {
      "t": "text",
      "v": "• lcm(arr) is the LCM of all elements of arr."
    },
    {
      "t": "text",
      "v": "Return the length of the longest product equivalent subarray of nums."
    },
    {
      "t": "text",
      "v": "Example 1:"
    },
    {
      "t": "text",
      "v": "Input: nums = [1,2,1,2,1,1,1]"
    },
    {
      "t": "text",
      "v": "Output: 5"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "The longest product equivalent subarray is [1, 2, 1, 1, 1], where prod([1, 2, 1, 1, 1]) = 2, gcd([1, 2, 1, 1, 1]) = 1, and lcm([1, 2, 1, 1, 1]) = 2."
    },
    {
      "t": "text",
      "v": "Example 2:"
    },
    {
      "t": "text",
      "v": "Input: nums = [2,3,4,5,6]"
    },
    {
      "t": "text",
      "v": "Output: 3"
    },
    {
      "t": "text",
      "v": "Explanation:"
    },
    {
      "t": "text",
      "v": "The longest product equivalent subarray is [3, 4, 5]."
    },
    {
      "t": "text",
      "v": "Example 3:"
    },
    {
      "t": "text",
      "v": "Input: nums = [1,2,3,1,4,5,1]"
    },
    {
      "t": "text",
      "v": "Output: 5"
    },
    {
      "t": "text",
      "v": "Constraints:"
    },
    {
      "t": "text",
      "v": "• 2 <= nums.length <= 100"
    },
    {
      "t": "text",
      "v": "• 1 <= nums[i] <= 10"
    }
  ]
}
